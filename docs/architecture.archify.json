  "cards": [
    {
      "dot": "emerald",
      "title": "Offline first",
      "items": [
        "The service worker precaches the app shell and every data file",
        "Map tiles you have already viewed are cached, up to 300",
        "At runtime the app calls no API except the map tiles"
      ]
    },
    {
      "dot": "cyan",
      "title": "Data pipeline",
      "items": [
        "fetch-boundaries.mjs keeps the kecamatan inside the Banyumas ADM2 polygon",
        "fetch-power.mjs reads their centroids and calls NASA POWER once per grid cell",
        "POWER is a ~50 km grid, so all 27 kecamatan fall in 2 cells"
      ]
    },
    {
      "dot": "amber",
      "title": "Next: the team's feature",
      "items": [
        "The Feature area card in the panel is empty on purpose",
        "The team decides the idea; this diagram is updated when the feature lands"
      ]
    },
    {
      "dot": "slate",
      "title": "Deploy",
      "items": [
        "CI type-checks and builds every pull request",
        "main deploys to GitHub Pages under /field-shift-banyumas/"
      ]
    }
